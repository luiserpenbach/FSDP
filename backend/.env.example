# FSDP backend configuration (copy to .env and adjust).
# All variables use the FSDP_ prefix.

# PostgreSQL connection string
FSDP_DATABASE_URL=postgresql+psycopg://fsdp:fsdp@localhost:5432/fsdp

# Allowed browser origins, JSON list format
FSDP_CORS_ORIGINS=["http://localhost:5173"]

# REQUIRED in any real deployment: session-token signing secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FSDP_SECRET_KEY=dev-insecure-secret-key-change-me

# Session cookie behavior. Set secure=true when serving over HTTPS.
FSDP_SESSION_TTL_HOURS=12
FSDP_SESSION_COOKIE_SECURE=false

# Bootstrap admin: created automatically at startup if it does not exist.
FSDP_ADMIN_EMAIL=admin@example.com
FSDP_ADMIN_PASSWORD=change-me-strong-password
FSDP_ADMIN_NAME=FSDP Admin

# Set false to disable the public OpenAPI docs (/docs, /redoc, /openapi.json).
FSDP_EXPOSE_DOCS=true

# Directory for catalog document uploads (relative to the backend working directory).
FSDP_CATALOG_FILES_DIR=var/catalog-files
