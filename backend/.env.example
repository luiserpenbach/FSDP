# FSDP backend configuration (copy to .env and adjust).
# All variables use the FSDP_ prefix.

# PostgreSQL connection string
FSDP_DATABASE_URL=postgresql+psycopg://fsdp:fsdp@localhost:5432/fsdp

# Allowed browser origins, JSON list format
FSDP_CORS_ORIGINS=["http://localhost:5173"]

# REQUIRED in any real deployment: session-token signing secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with the default below unless FSDP_ALLOW_INSECURE_SECRET=true.
FSDP_SECRET_KEY=dev-insecure-secret-key-change-me
# Local development only: allow starting with the insecure default secret above.
FSDP_ALLOW_INSECURE_SECRET=false

# Session cookie behavior. Set secure=true when serving over HTTPS.
FSDP_SESSION_TTL_HOURS=12
FSDP_SESSION_COOKIE_SECURE=false

# Sign-in lockout: consecutive failures before an account is locked, and for how long.
FSDP_LOGIN_MAX_FAILURES=5
FSDP_LOGIN_LOCK_MINUTES=5

# Single sign-on (OpenID Connect). On when issuer, client id and redirect URL are set.
# Register the redirect URL with the provider exactly as written here.
# FSDP_OIDC_ISSUER=https://login.example.com/realms/engineering
# FSDP_OIDC_CLIENT_ID=fsdp
# FSDP_OIDC_CLIENT_SECRET=
# FSDP_OIDC_REDIRECT_URL=https://fsdp.example.com/api/auth/sso/callback
# Where the browser lands after signing in (the frontend), and the button text.
# FSDP_OIDC_POST_LOGIN_URL=/
# FSDP_OIDC_LABEL=Sign in with SSO
# Role of an account created by its first SSO sign-in: viewer or engineer.
# FSDP_OIDC_DEFAULT_ROLE=viewer
# Email domains allowed to sign in with SSO (JSON list); empty allows all.
# FSDP_OIDC_ALLOWED_DOMAINS=["example.com"]
# Set false to make SSO the only way in for everyone but administrators.
FSDP_PASSWORD_LOGIN_ENABLED=true

# Bootstrap admin: created automatically at startup if it does not exist.
FSDP_ADMIN_EMAIL=admin@example.com
FSDP_ADMIN_PASSWORD=change-me-strong-password
FSDP_ADMIN_NAME=FSDP Admin

# Set false to disable the public OpenAPI docs (/docs, /redoc, /openapi.json).
FSDP_EXPOSE_DOCS=true

# Directory for catalog document uploads (relative to the backend working directory).
FSDP_CATALOG_FILES_DIR=var/catalog-files

# Server-side sheet index and DRC: path to the bundled schematic engine
# (cd frontend && npm run build:engine -> frontend/dist-engine/engine-cli.mjs), run
# under Node. Empty = off: sheets are indexed by the browser only. The Docker image
# sets this itself.
FSDP_ENGINE_CLI=
FSDP_ENGINE_NODE=node
FSDP_ENGINE_TIMEOUT_SECONDS=60
